:"2026-10-24 10:43:00","level":"Information","listUrl":"https://tsunami.incois.gov.in/itews/DSSProducts/OPR/past90days.json","ocean":"PO","topoBathy":"1111 m","updatesText":"No further bulletins will be issued by ITEWC INCOIS for this event unless additional information becomes available."},"md5":"4db05f39bba95c517257f9a98549db28","source":"incois"},{"Data":{"id":"BOLETIN_INFORMATIVO_001_20261019_085738","updates":1,"shockTime":"2026-10-19 22:47:45","latitude":14.58,"longitude":-91.49,"depth":10.0,"magnitude":5.0,"placeName":"危地马拉","agency":"CAT","bulletinUrl":"https://diredimoat.semar.gob.mx/cat/Boletines/BOLETIN_INFORMATIVO_001_20261019_085738.txt","capUrl":"https://diredimoat.semar.gob.mx/cat/rss/ultimo_boletin.xml","certainty":"Unlikely","description":"Con base en la informacion preliminar del sismo, NO SE ESPERA LA GENERACION DE UN TSUNAMI; por lo tanto, no se preven variaciones significativas del nivel del mar.","eventId":"BOLETIN_INFORMATIVO_001_20261019_085738","headline":"BOLETIN INFORMATIVO 001 20261019 085738","instruction":"Ninguna.\n\nEste sera el unico boletin que se emita para este evento, a menos que se reciba informacion complementaria.\"","issueTime":"2026-10-19 22:57:38","level":"Information","senderName":"CENTRO DE ALERTA DE TSUNAMIS (CAT-SEMAR)","severity":"Minor","urgency":"Unknown"},"md5":"2da4beb8f90cc7856784195765e4fb91","source":"cat_tsunami"},{"Data":{"id":"115007-1","updates":1,"shockTime":"2026-10-24 10:31:00","latitude":-13.8,"longitude":165.7,"depth":10.0,"magnitude":7.2,"placeName":"大洋洲 萬那杜群島","agency":"CWA","description":"頃獲太平洋海嘯警報中心通報，２０２６年１０月２４日１０時３１分（臺灣時間），大洋洲\u3000萬那杜群島發生規模７﹒２地震，震央位於東經１６５﹒７０度、南緯１３﹒８０度。該中心研判可能在太平洋地區引發海嘯威脅，本署將嚴密監視海嘯的後續影響，隨時提供最新資訊。","eventId":"115007","expires":"2026-10-24 18:44:00","headline":"海嘯消息 第1報","issueTime":"2026-10-24 10:44:00","level":"Information","reportColor":"黃色","reportType":"海嘯消息","updateTime":"2026-10-24 10:44:00"},"md5":"c12b70bbdde15005d4d0f5ed3e26a033","source":"cwa_tsunami"},{"Data":{"id":"23108441600000_20261024105021","headline":"黑龙江省牡丹江市宁安市气象台发布大风蓝色预警信号","effective":"2026/10/24 10:45","description":"宁安市气象台2026年10月24日10时45分继续发布大风蓝色预警信号：预计未来24小时，我市将出现5-6级大风天气，阵风可达7级以上，请相关部门及个人做好防范工作。\n\n防御指南：\n1.政府及相关部门按照职责做好防大风工作；\n2.关好门窗，加固围板、棚架、广告牌等易被风吹动的搭建物，妥善安置易受大风影响的室外物品，遮盖建筑物资；\n3. 相关水域水上作业和过往船舶采取积极的应对措施，如回港避风或者绕道航行等；\n4.行人注意尽量少骑自行车，刮风时不要在广告牌、临时搭建物等下面逗留；\n5.有关部门和单位注意森林、草原等防火。","type":"p0007004","title":"黑龙江省牡丹江市宁安市气象台发布大风蓝色预警信号","img":"https://image.nmc.cn/assets/img/alarm/p0007004.png"},"md5":"cd4db44547096a1d016ec6c56ecad617","source":"weatheralarm"},{"Data":{"kindCode":"VFVO60","activity":"","craterName":"南岳山頂火口","elevation":1117,"headline":"","id":"VFVO60_20261024115200_506","infoKind":"推定噴煙流向報","infoTypeName":"発表","kindName":"推定喷烟流向报","latitude":31.5925,"longitude":130.65666666666667,"nextAdvisory":"","observation":"","plumeDirection":"北","plumeHeight":1200,"plumeHeightSea":7500,"prevention":"","publishingOffice":"気象庁","reportTime":"2026-10-24 11:52:00","targetTime":"2026-10-24 11:45:00","title":"桜島 推定噴煙流向報","updates":1,"volcanoCode":"506","volcanoName":"桜島","windTime":"2026-10-24 12:00:00","winds":[{"degree":160,"heightFt":0,"speedKt":20},{"degree":160,"heightFt":1000,"speedKt":24},{"degree":160,"heightFt":2000,"speedKt":25},{"degree":170,"heightFt":3000,"speedKt":26},{"degree":180,"heightFt":4000,"speedKt":24},{"degree":190,"heightFt":5000,"speedKt":23},{"degree":190,"heightFt":6000,"speedKt":20},{"degree":180,"heightFt":7000,"speedKt":18},{"degree":190,"heightFt":8000,"speedKt":17},{"degree":190,"heightFt":9000,"speedKt":19},{"degree":190,"heightFt":10000,"speedKt":23},{"degree":200,"heightFt":11000,"speedKt":27},{"degree":200,"heightFt":12000,"speedKt":29},{"degree":200,"heightFt":13000,"speedKt":30},{"degree":200,"heightFt":14000,"speedKt":31},{"degree":210,"heightFt":15000,"speedKt":31},{"degree":210,"heightFt":16000,"speedKt":29},{"degree":210,"heightFt":17000,"speedKt":27},{"degree":210,"heightFt":18000,"speedKt":29},{"degree":220,"heightFt":19000,"sp