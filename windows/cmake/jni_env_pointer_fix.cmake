# jni 1.1.0 passes JNIEnv** to desktop JVM functions requiring void**.
# Build an adapted copy, never mutate the shared Pub cache/plugin symlink.
# JNI ABI: https://docs.oracle.com/en/java/javase/22/docs/specs/jni/invocation.html
if(NOT WIN32 OR NOT TARGET jni)
  return()
endif()

function(rq_fix_jni_env_pointers)
  get_target_property(jni_source jni SOURCE_DIR)
  set(patched_source "${CMAKE_CURRENT_BINARY_DIR}/rq_jni_windows_src")
  file(GLOB_RECURSE source_files CONFIGURE_DEPENDS
    RELATIVE "${jni_source}" "${jni_source}/*")
  foreach(relative IN LISTS source_files)
    set(original "${jni_source}/${relative}")
    set(adapted "${patched_source}/${relative}")
    if(relative STREQUAL "dartjni.h" OR relative STREQUAL "dartjni.c")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
      file(READ "${original}" contents)
      if(relative STREQUAL "dartjni.h")
        set(before "(*jni->jvm)->AttachCurrentThread(jni->jvm, &jniEnv, NULL);")
        set(after "(*jni->jvm)->AttachCurrentThread(jni->jvm, (void**)&jniEnv, NULL);")
      else()
        set(before "JNI_CreateJavaVM(&jni_context.jvm, &jniEnv, initArgs)")
        set(after "JNI_CreateJavaVM(&jni_context.jvm, (void**)&jniEnv, initArgs)")
      endif()
      string(FIND "${contents}" "${before}" unpatched_at)
      string(FIND "${contents}" "${after}" patched_at)
      if(unpatched_at EQUAL -1 AND patched_at EQUAL -1)
        message(FATAL_ERROR "JNI Windows source changed: review ${relative} pointer adaptation")
      endif()
      string(REPLACE "${before}" "${after}" contents "${contents}")
      # Preserve timestamps on configure when the generated source is unchanged.
      set(previous "")
      if(EXISTS "${adapted}")
        file(READ "${adapted}" previous)
      endif()
      if(NOT previous STREQUAL contents)
        get_filename_component(parent "${adapted}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        file(WRITE "${adapted}" "${contents}")
      endif()
    else()
      configure_file("${original}" "${adapted}" COPYONLY)
    endif()
  endforeach()

  get_target_property(original_sources jni SOURCES)
  set(adapted_sources)
  foreach(source IN LISTS original_sources)
    get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${jni_source}")
    file(RELATIVE_PATH relative "${jni_source}" "${absolute}")
    if(relative MATCHES "^[.][.]/")
      message(FATAL_ERROR "JNI source outside plugin directory: ${source}")
    endif()
    list(APPEND adapted_sources "${patched_source}/${relative}")
  endforeach()
  set_property(TARGET jni PROPERTY SOURCES "${adapted_sources}")
endfunction()

rq_fix_jni_env_pointers()
